# ---- Data source --------------------------------------------------------
# Default mode: read the Hugging Face dataset repo directly over hf://.
DATASET_REPO=NhiBatauga/Telegram-Database
DATASET_REVISION=main
DATASET_GLOB=**/*.parquet
DATASET_CONFIG=default
DATASET_SPLIT=train

# true  -> list the repo's real .parquet files via the hub tree API (falls back
#          to the auto-converted shards), cached 24h in /tmp
# false -> glob the repo over hf:// instead
DISCOVER_PARQUET=true
# Merge shards by column name (safe default; handles schema drift).
PARQUET_UNION_BY_NAME=true

# Only needed if the dataset is private or gated.
HF_TOKEN=

# ---- Optional overrides (leave empty to use the dataset repo) -----------
# Plain HTTPS parquet URLs, comma separated. Wins over everything else.
# e.g. https://huggingface.co/datasets/Kzr0xx/telegram/resolve/main/data.parquet
PARQUET_URLS=

# S3-compatible source (HF buckets, R2, MinIO). Used only if both are set.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_URL_STYLE=path
PARQUET_GLOB=

# Lookup-optimized copies from scripts/build_indexes.py (big speedup for
# phone/username lookups). Same format as PARQUET_URLS, or an hf:// path.
PHONE_SOURCE=
USERNAME_SOURCE=

# ---- API ----------------------------------------------------------------
API_KEYS=change-me-now
REQUIRE_AUTH=true
ALLOW_RAW_SQL=false
CORS_ORIGINS=*

# ---- Engine tuning (Render free tier = 512MB RAM) -----------------------
DUCKDB_MEMORY_LIMIT=350MB
DUCKDB_THREADS=2
MAX_LIMIT=200
CACHE_TTL_SECONDS=900
CACHE_MAXSIZE=1024
QUERY_TIMEOUT_SECONDS=110
# per-request timeout / retries for DuckDB's HTTP client (seconds)
HTTP_TIMEOUT_SECONDS=120
HTTP_RETRIES=5
# bootstrap in a background thread so the port binds immediately
WARMUP_IN_BACKGROUND=true
